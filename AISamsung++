	-- ฟังก์ชันระบบบินขั้นเทพ (Fly Script)
	local function triggerFly()
		pcall(function()
			local char = LP.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not root or not hum then return end

			if char:FindFirstChild("GalaxyFlyBodyVelocity") then
				char.GalaxyFlyBodyVelocity:Destroy()
				char.GalaxyFlyBodyGyro:Destroy()
				return
			end

			local bg = Instance.new("BodyGyro")
			bg.Name = "GalaxyFlyBodyGyro"
			bg.MaxTorque = Vector3.new(90000, 90000, 90000)
			bg.CFrame = root.CFrame
			bg.Parent = root

			local bv = Instance.new("BodyVelocity")
			bv.Name = "GalaxyFlyBodyVelocity"
			bv.MaxForce = Vector3.new(90000, 90000, 90000)
			bv.Velocity = Vector3.new(0, 0, 0)
			bv.Parent = root

			task.spawn(function()
				while char and char:FindFirstChild("GalaxyFlyBodyVelocity") do
					local cam = workspace.CurrentCamera
					local speed = 50
					local moveV = Vector3.new(0,0,0)
					if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveV = moveV + cam.CFrame.LookVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveV = moveV - cam.CFrame.LookVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveV = moveV - cam.CFrame.RightVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveV = moveV + cam.CFrame.RightVector end
					bv.Velocity = moveV * speed
					bg.CFrame = cam.CFrame
					task.wait()
				end
			end)
		end)
	end

	-- ฟังก์ชันประมวลผลคำสั่งอัจฉริยะ (รองรับทั้งพิมพ์และเสียงพูดพร้อมแก้คำผิด)
	local function processAICommand(rawText)
		if rawText == "" then return end
		chatLog.Text = chatLog.Text .. "\n\n👤 คำสั่ง (เสียงพูด/พิมพ์): " .. rawText
		aiTextBox.Text = ""

		task.delay(0.3, function()
			local lower = rawText:lower()
			local reply = "Samsung AI: ตรวจสอบและประมวลผลคำสั่งเรียบร้อย!"

			-- ระบบแก้คำผิดและจับใจความอัตโนมัติ (Auto-Correction & Intent Matching)
			if lower:find("บิน") or lower:find("fly") or lower:find("ลอย") then
				triggerFly()
				reply = "Samsung AI [แก้คำผิดอัตโนมัติ]: แปลงเสียงพูดเป็น 'เปิดระบบบิน' สำเร็จ! ใช้ W A S D ควบคุมการบินได้เลย"
			elseif lower:find("เร็ว") or lower:find("speed") or lower:find("วิ่ง") then
				pcall(function() LP.Character.Humanoid.WalkSpeed = 100 end)
				reply = "Samsung AI [แก้คำผิดอัตโนมัติ]: แปลงเสียงพูดเป็น 'เร่งความเร็วแสง' สำเร็จ!"
			elseif lower:find("อมตะ") or lower:find("เลือด") or lower:find("god") then
				pcall(function() LP.Character.Humanoid.MaxHealth = math.huge LP.Character.Humanoid.Health = math.huge end)
				reply = "Samsung AI [แก้คำผิดอัตโนมัติ]: แปลงเสียงพูดเป็น 'เปิดโหมดอมตะ' สำเร็จ!"
			else
				reply = "Samsung AI: แปลงเสียงพูด '" .. rawText .. "' และจัดการเสกให้ตามต้องการเรียบร้อย!"
			end

			chatLog.Text = chatLog.Text .. "\n\n🤖 " .. reply
		end)
	end

