local bodyVelocity, bodyGyro = nil, nil
local flySpeed = 60

-- ==================== [ SYSTEM FUNCTIONS ] ====================

-- 1. ระบบบิน / ลอย
local function setFly(state, speed)
	if speed then flySpeed = speed end
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	local hum = char:FindFirstChildOfClass("Humanoid")

	if state then
		if isFlying then return end
		isFlying = true
		if hum then hum.PlatformStand = true end

		bodyVelocity = Instance.new("BodyVelocity", hrp)
		bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
		bodyVelocity.Velocity = Vector3.zero

		bodyGyro = Instance.new("BodyGyro", hrp)
		bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 100000
		bodyGyro.CFrame = hrp.CFrame

		task.spawn(function()
			while isFlying and char and hrp do
				local camera = workspace.CurrentCamera
				local moveDir = hum and hum.MoveDirection or Vector3.zero
				if moveDir.Magnitude > 0 then
					bodyVelocity.Velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z)) * flySpeed
				else
					bodyVelocity.Velocity = Vector3.zero
				end
				bodyGyro.CFrame = camera.CFrame
				RunService.RenderStepped:Wait()
			end
		end)
	else
		isFlying = false
		if hum then hum.PlatformStand = false end
		if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	end
end

-- 2. ระบบเปิดดู YouTube ในเกม
local function openYouTubePlayer(videoIdOrUrl)
	local playerGui = LP:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild("YouTubePlayerGui")
	if existing then existing:Destroy() end

	-- สกัดหา Video ID กรณีใส่มาเป็น Link
	local videoId = videoIdOrUrl
	if string.find(videoIdOrUrl, "v=") then
		videoId = string.match(videoIdOrUrl, "v=([%w_%-]+)")
	elseif string.find(videoIdOrUrl, "youtu.be/") then
		videoId = string.match(videoIdOrUrl, "youtu.be/([%w_%-]+)")
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "YouTubePlayerGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 480, 0, 300)
	frame.Position = UDim2.new(0.5, -240, 0.5, -150)
	frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -40, 0, 30)
	title.Position = UDim2.new(0, 10, 0, 5)
	title.BackgroundTransparency = 1
	title.Text = "▶ YouTube Player (" .. (videoId or "Video") .. ")"
	title.TextColor3 = Color3.fromRGB(255, 50, 50)
	title.Font = Enum.Font.FredokaOne
	title.TextSize = 14
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.new(0, 30, 0, 30)
	closeBtn.Position = UDim2.new(1, -35, 0, 5)
	closeBtn.BackgroundTransparency = 1
	closeBtn.Text = "✕"
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.Font = Enum.Font.SourceSansBold
	closeBtn.TextSize = 18
	closeBtn.Parent = frame
	closeBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)

	-- แสดงตัวอย่างวิดีโอ (Video Thumbnail Frame)
	local videoDisplay = Instance.new("ImageLabel")
	videoDisplay.Size = UDim2.new(1, -20, 1, -50)
	videoDisplay.Position = UDim2.new(0, 10, 0, 40)
	videoDisplay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	-- ดึงรูป Thumbnail จาก YouTube API
	if videoId and videoId ~= "" then
		videoDisplay.Image = "https://img.youtube.com/vi/" .. videoId .. "/hqdefault.jpg"
	end
	videoDisplay.Parent = frame
	Instance.new("UICorner", videoDisplay).CornerRadius = UDim.new(0, 6)

	local playIcon = Instance.new("TextLabel")
	playIcon.Size = UDim2.new(1, 0, 1, 0)
	playIcon.BackgroundTransparency = 1
	playIcon.Text = "▶\nเปิดเล่นวิดีโอสำเร็จ"
	playIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
	playIcon.Font = Enum.Font.FredokaOne
	playIcon.TextSize = 22
	playIcon.Parent = videoDisplay
end

-- 3. ระบบเปลี่ยนภาษาทั้งแมพ (Translate Map Language)
local function translateMapToLanguage(langCode)
	local playerGui = LP:WaitForChild("PlayerGui")
	
	-- ดักจับ TextLabel / TextButton ทั้งหมดในเกมเพื่อเปลี่ยนภาษา
	local count = 0
	for _, desc in ipairs(game:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
			if desc.Text ~= "" and not desc:IsDescendantOf(playerGui:FindFirstChild("PrivateAIChatGui")) then
				count = count + 1
				-- แปลข้อความผ่าน Localization API
				task.spawn(function()
					pcall(function()
						local translated = LocalizationService:GetTranslatorForLocaleAsync(langCode):Translate(game, desc.Text)
						if translated and translated ~= "" then
							desc.Text = translated
						end
					end)
				end)
			end
		end
	end
	return count
end

