-- Variables สำหรับระบบ UI แชทส่วนตัว
local addChatMessage = function(sender, text, color) end

-- ==================== [ AI PROCESSOR ] ====================

local function processAICommand(msg)
	local text = string.lower(msg)
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	local numberInput = tonumber(string.match(text, "%d+%.?%d*"))

	-- A. ระบบดู YouTube
	if string.find(text, "ยูทูป") or string.find(text, "youtube") or string.find(text, "yt") or string.find(text, "คลิป") or string.find(text, "เพลง") then
		local videoId = string.match(msg, "https?://%S+") or string.match(msg, "watch%?v=(%S+)") or string.match(msg, "youtu%.be/(%S+)") or string.match(msg, "%w%w%w%w%w%w%w%w%w%w%w")
		if videoId then
			openYouTubePlayer(videoId)
			addChatMessage("AI", "เปิดหน้าต่างดู YouTube เรียบร้อยครับ!", Color3.fromRGB(255, 80, 80))
		else
			openYouTubePlayer("dQw4w9WgXcQ") -- Demo Video
			addChatMessage("AI", "เปิดหน้าจอ YouTube Player ให้แล้วครับ! (ระบุลิงก์หลังคำสั่ง เช่น 'ดูยูทูป https://...' เพื่อเปิดคลิปที่ต้องการได้เลย)", Color3.fromRGB(255, 80, 80))
		end

	-- B. ระบบเปลี่ยนภาษาทั้งแมพ
	elseif string.find(text, "ภาษา") or string.find(text, "แปล") or string.find(text, "เปลี่ยนภาษา") or string.find(text, "lang") then
		local selectedLang = "en"
		local langName = "ภาษาอังกฤษ"

		for key, code in pairs(languageCodes) do
			if string.find(text, key) then
				selectedLang = code
				langName = key
				break
			end
		end

		local count = translateMapToLanguage(selectedLang)
		addChatMessage("AI", "กำลังเปลี่ยนภาษาทั้งแมพเป็น " .. langName .. " (" .. selectedLang .. ") รวมทั้งหมด " .. count .. " ข้อความ...", Color3.fromRGB(0, 200, 255))

	-- C. หมวดการบิน / ลอย
	elseif string.find(text, "บิน") or string.find(text, "ลอย") or string.find(text, "เหาะ") then
		if string.find(text, "หยุด") or string.find(text, "เลิก") or string.find(text, "ปิด") or string.find(text, "ลง") then
			setFly(false)
			addChatMessage("AI", "ยกเลิกการบินเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 60
			setFly(true, spd)
			addChatMessage("AI", "เปิดโหมดบินความเร็ว " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- D. หมวดความเร็ว (วิ่ง / เดิน)
	elseif string.find(text, "วิ่ง") or string.find(text, "เดิน") or string.find(text, "สปีด") or string.find(text, "เร็ว") then
		if string.find(text, "ปกติ") then
			if hum then hum.WalkSpeed = 16 end
			addChatMessage("AI", "ปรับความเร็วกลับเป็นปกติ (16) แล้วครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 100
			if hum then hum.WalkSpeed = spd end
			addChatMessage("AI", "ปรับความเร็ววิ่งเป็น " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- E. หมวดการกระโดด
	elseif string.find(text, "โดด") or string.find(text, "สูง") then
		if string.find(text, "ปกติ") then
			if hum then hum.JumpPower = 50 end
			addChatMessage("AI", "ปรับแรงกระโดดกลับเป็นปกติ (50) แล้วครับ", Color3.fromRGB(255, 200, 100))
		else
			local jp = numberInput or 150
			if hum then hum.UseJumpPower = true hum.JumpPower = jp end
			addChatMessage("AI", "ปรับแรงกระโดดเป็น " .. jp .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- F. หมวดขนาดตัวละคร
	elseif string.find(text, "ใหญ่") or string.find(text, "เล็ก") or string.find(text, "ย่อ") or string.find(text, "ตัว") then
		local scale = numberInput or (string.find(text, "เล็ก") and 0.5 or 2)
		if hum then
			for _, prop in ipairs({"BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale"}) do
				local s = hum:FindFirstChild(prop)
				if s then s.Value = scale end
			end
		end
		addChatMessage("AI", "ปรับขนาดตัวละครเป็น " .. scale .. " เท่าเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))

	-- G. หมวดวาร์ป
	elseif string.find(text, "วาป") or string.find(text, "วาร์ป") or string.find(text, "ไป") then
		local dist = numberInput or 50
		if hrp then
			if string.find(text, "ฟ้า") or string.find(text, "สูง") or string.find(text, "บน") then
				hrp.CFrame = hrp.CFrame + Vector3.new(0, dist, 0)
				addChatMessage("AI", "วาร์ปขึ้นฟ้า " .. dist .. " หน่วยเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
			else
				hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * dist)
				addChatMessage("AI", "วาร์ปไปข้างหน้า " .. dist .. " หน่วยเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
			end
		end

	-- H. หมวดมองทะลุ
	elseif string.find(text, "ทะลุ") then
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
		addChatMessage("AI", "เปิดโหมดเดินทะลุสิ่งกีดขวางแล้วครับ", Color3.fromRGB(100, 255, 100))

	-- I. หมวดรีเซ็ต
	elseif string.find(text, "รี") or string.find(text, "ปกติ") then
		setFly(false)
		if hum then
			hum.WalkSpeed = 16
			hum.JumpPower = 50
			for _, prop in ipairs({"BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale"}) do
				local s = hum:FindFirstChild(prop)
				if s then s.Value = 1 end
			end
		end
		addChatMessage("AI", "รีเซ็ตสถานะตัวละครกลับเป็นปกติเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))
	else
		addChatMessage("AI", "ลองสั่งงาน เช่น 'ดูยูทูป', 'เปลี่ยนภาษาเป็นภาษาอังกฤษ', 'แปลเป็นญี่ปุ่น', 'บิน', 'วิ่งเร็ว 100'", Color3.fromRGB(255, 100, 100))
	end
end

