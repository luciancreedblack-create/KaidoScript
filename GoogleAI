-- 3. ระบบเปลี่ยนภาษาทั้งแมพ
local function translateMapToLanguage(langCode)
	local playerGui = LP:WaitForChild("PlayerGui")
	local count = 0
	for _, desc in ipairs(game:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
			if desc.Text ~= "" and not desc:IsDescendantOf(playerGui:FindFirstChild("PrivateAIChatGui")) then
				count = count + 1
				task.spawn(function()
					pcall(function()
						local translated = LocalizationService:GetTranslatorForLocaleAsync(langCode):Translate(game, desc.Text)
						if translated and translated ~= "" then
							desc.Text = translated
						end
					end)
				end)
			end
		end
	end
	return count
end

-- 4. ระบบวาร์ปไปจุดชัยชนะ Obby
local function teleportToVictory()
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
	local hrp = char.HumanoidRootPart

	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("BasePart") or item:IsA("Model") then
			local name = string.lower(item.Name)
			if string.find(name, "win") or string.find(name, "victory") or string.find(name, "finish") or string.find(name, "end") or string.find(name, "ชัยชนะ") then
				local targetCFrame = item:IsA("Model") and item:GetPivot() or item.CFrame
				hrp.CFrame = targetCFrame + Vector3.new(0, 4, 0)
				return true
			end
		end
	end
	
	hrp.CFrame = hrp.CFrame + Vector3.new(0, 300, 0)
	return true
end

-- 5. ระบบ AI เล่นเกมออบบี้ให้อัตโนมัติ (AUTO PLAY OBBY)
local function startAutoPlayObby()
	if isAutoObbyActive then return end
	isAutoObbyActive = true

	task.spawn(function()
		-- ค้นหาโฟลเดอร์สำหรับ Stage/Checkpoints
		local stagesFolder = workspace:FindFirstChild("Stages") 
			or workspace:FindFirstChild("Checkpoints") 
			or workspace:FindFirstChild("SpawnPoints")
			or workspace:FindFirstChild("Stage")

		local stagesList = {}

		if stagesFolder then
			for _, child in ipairs(stagesFolder:GetChildren()) do
				if child:IsA("BasePart") or child:IsA("Model") then
					table.insert(stagesList, child)
				end
			end
			-- จัดเรียงตามลำดับชื่อด่าน (1, 2, 3...)
			table.sort(stagesList, function(a, b)
				local numA = tonumber(string.match(a.Name, "%d+")) or 0
				local numB = tonumber(string.match(b.Name, "%d+")) or 0
				return numA < numB
			end)
		else
			-- หากไม่พบโฟลเดอร์ ให้เก็บ Part ที่เข้าข่าย Checkpoint ทั่วทั้ง Workspace
			for _, item in ipairs(workspace:GetDescendants()) do
				if item:IsA("BasePart") or item:IsA("SpawnLocation") then
					local name = string.lower(item.Name)
					if string.find(name, "stage") or string.find(name, "checkpoint") or string.find(name, "spawn") then
						table.insert(stagesList, item)
					end
				end
			end
		end

		if #stagesList == 0 then
			isAutoObbyActive = false
			return false
		end

		-- วนลูปให้ AI พานักเรียนผ่านด่านทีละจุดอย่างราบรื่น
		for i, targetStage in ipairs(stagesList) do
			if not isAutoObbyActive then break end

			local char = LP.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local hrp = char.HumanoidRootPart
				local targetCFrame = targetStage:IsA("Model") and targetStage:GetPivot() or targetStage.CFrame

				-- ย้าย CFrame ไปจุดด่านถัดไปพร้อมเว้นระยะเพื่อความปลอดภัย
				hrp.CFrame = targetCFrame + Vector3.new(0, 3.5, 0)
				task.wait(0.3) -- เว้นช่วงสั้นๆ ป้องกันระบบตรวจจับ
			end
		end

		isAutoObbyActive = false
		return true
	end)
end

local function stopAutoPlayObby()
	isAutoObbyActive = false
end

