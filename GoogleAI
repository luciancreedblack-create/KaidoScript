-- ==================== [ AUTO SPEECH TO TEXT SETUP ] ====================

local function setupSpeechToTextEngine()
	task.spawn(function()
		local char = LP.Character or LP.CharacterAdded:Wait()
		
		local audioDeviceInput = Instance.new("AudioDeviceInput")
		audioDeviceInput.Name = "AutoVoiceInput"
		audioDeviceInput.Player = LP
		audioDeviceInput.Parent = char

		local audioSpeechToText = Instance.new("AudioSpeechToText")
		audioSpeechToText.Name = "AutoSpeechToText"
		audioSpeechToText.Enabled = true
		audioSpeechToText.Parent = char

		local wire = Instance.new("Wire")
		wire.Name = "VoiceWire"
		wire.SourceInstance = audioDeviceInput
		wire.SourceName = "Output"
		wire.TargetInstance = audioSpeechToText
		wire.TargetName = "Input"
		wire.Parent = char

		audioSpeechToText:GetPropertyChangedSignal("Text"):Connect(function()
			local textResult = audioSpeechToText.Text
			if textResult and textResult ~= "" then
				addChatMessage("คุณ (พูด)", textResult, Color3.fromRGB(150, 255, 150))
				processAICommand(textResult)
			end
		end)
	end)
end

-- ==================== [ HIGH-IQ SMART AI PROCESSOR ] ====================

processAICommand = function(msg)
	local text = string.lower(msg)
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	local numberInput = tonumber(string.match(text, "%d+%.?%d*"))

	-- A. ระบบ AI เล่นเกมอัตโนมัติ (AUTO PLAY OBBY)
	if string.find(text, "ออโต้") or string.find(text, "เล่นเอง") or string.find(text, "อัตโนมัติ") or string.find(text, "auto") or string.find(text, "bot") then
		if string.find(text, "หยุด") or string.find(text, "ปิด") or string.find(text, "stop") or string.find(text, "เลิก") then
			stopAutoPlayObby()
			addChatMessage("AI", "หยุดระบบการเล่นออบบี้อัตโนมัติแล้วครับ", Color3.fromRGB(255, 150, 100))
		else
			startAutoPlayObby()
			addChatMessage("AI", "🚀 เปิดใช้งานระบบ AI เล่นเกมออบบี้ให้อัตโนมัติแล้วครับ!", Color3.fromRGB(0, 255, 170))
		end

	-- B. วาร์ปไปออบบี้ / จุดชัยชนะ
	elseif string.find(text, "ออบบี้") or string.find(text, "ออบบร้") or string.find(text, "obby") or string.find(text, "ชัยชนะ") or string.find(text, "ด่าน") or string.find(text, "เข้าแมพ") then
		teleportToVictory()
		addChatMessage("AI", "วาร์ปไปที่ชัยชนะเรียบร้อยครับ!", Color3.fromRGB(0, 255, 150))

	-- C. เปิดดู YouTube
	elseif string.find(text, "ยูทูป") or string.find(text, "youtube") or string.find(text, "yt") or string.find(text, "คลิป") or string.find(text, "เพลง") or string.find(text, "ฟัง") then
		local videoId = string.match(msg, "https?://%S+") or string.match(msg, "watch%?v=(%S+)") or string.match(msg, "youtu%.be/(%S+)") or string.match(msg, "%w%w%w%w%w%w%w%w%w%w%w")
		openYouTubePlayer(videoId or "dQw4w9WgXcQ")
		addChatMessage("AI", "เปิดหน้าต่างเล่น YouTube ให้เรียบร้อยครับ!", Color3.fromRGB(255, 80, 80))

	-- D. เปลี่ยนภาษา
	elseif string.find(text, "ภาษา") or string.find(text, "แปล") or string.find(text, "เปลี่ยนภาษา") or string.find(text, "lang") then
		local selectedLang = "en"
		local langName = "ภาษาอังกฤษ"
		for key, code in pairs(languageCodes) do
			if string.find(text, key) then
				selectedLang = code
				langName = key
				break
			end
		end
		translateMapToLanguage(selectedLang)
		addChatMessage("AI", "ทำการเปลี่ยนภาษาแมพเป็น " .. langName .. " เรียบร้อยครับ!", Color3.fromRGB(0, 200, 255))

	-- E. บิน
	elseif string.find(text, "บิน") or string.find(text, "ลอย") or string.find(text, "เหาะ") or string.find(text, "fly") then
		if string.find(text, "หยุด") or string.find(text, "ปิด") or string.find(text, "ลง") or string.find(text, "เลิก") then
			setFly(false)
			addChatMessage("AI", "ปิดระบบการบินเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 60
			setFly(true, spd)
			addChatMessage("AI", "เปิดโหมดบินความเร็ว " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- F. ปรับความเร็ว
	elseif string.find(text, "วิ่ง") or string.find(text, "เดิน") or string.find(text, "สปีด") or string.find(text, "เร็ว") or string.find(text, "speed") then
		if string.find(text, "ปกติ") then
			if hum then hum.WalkSpeed = 16 end
			addChatMessage("AI", "ปรับความเร็วเดินปกติแล้วครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 100
			if hum then hum.WalkSpeed = spd end
			addChatMessage("AI", "ปรับความเร็วการวิ่งเป็น " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- G. กระโดด
	elseif string.find(text, "โดด") or string.find(text, "สูง") or string.find(text, "jump") then
		local jp = numberInput or 150
		if hum then hum.UseJumpPower = true hum.JumpPower = jp end
		addChatMessage("AI", "ปรับแรงกระโดดสูงขึ้นเป็น " .. jp .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))

	-- H. ขนาดตัว
	elseif string.find(text, "ใหญ่") or string.find(text, "เล็ก") or string.find(text, "ย่อ") or string.find(text, "ตัว") then
		local scale = numberInput or (string.find(text, "เล็ก") and 0.5 or 2)
		if hum then
			for _, prop in ipairs({"BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale"}) do
				local s = hum:FindFirstChild(prop)
				if s then s.Value = scale end
			end
		end
		addChatMessage("AI", "ปรับขนาดตัวละครเป็น " .. scale .. " เท่าเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))

	-- I. วาร์ป
	elseif string.find(text, "วาป") or string.find(text, "วาร์ป") or string.find(text, "ไป") or string.find(text, "tp") then
		local dist = numberInput or 50
		if hrp then
			if string.find(text, "ฟ้า") or string.find(text, "สูง") or string.find(text, "บน") then
				hrp.CFrame = hrp.CFrame + Vector3.new(0, dist, 0)
				addChatMessage("AI", "วาร์ปขึ้นด้านบน " .. dist .. " หน่วยเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
			else
				hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * dist)
				addChatMessage("AI", "วาร์ปไปด้านหน้า " .. dist .. " หน่วยเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
			end
		end

	-- J. คำทักทาย / คุยเล่น
	elseif string.find(text, "หวัดดี") or string.find(text, "สวัสดี") or string.find(text, "hi") or string.find(text, "hello") or string.find(text, "ไง") then
		addChatMessage("AI", "สวัสดีครับ! สั่งงานได้เลยครับ พิมพ์หรือพูดว่า 'ออโต้ออบบี้' เพื่อให้ AI เล่นเกมแทนได้นะ!", Color3.fromRGB(150, 220, 255))
	elseif string.find(text, "ใคร") or string.find(text, "ทำไร") or string.find(text, "เก่ง") then
		addChatMessage("AI", "ผมคือ AI ประจำตัวของคุณ พร้อมเล่นเกมออบบี้อัตโนมัติ บิน วาร์ป และช่วยเหลือคุณครับ!", Color3.fromRGB(150, 220, 255))
	else
		addChatMessage("AI", "รับทราบครับ! กำลังประมวลผลคำสั่ง '" .. msg .. "' และพร้อมช่วยเหลือคุณครับ", Color3.fromRGB(180, 220, 255))
	end
end

