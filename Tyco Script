-- ========== ระบบโดเนทพิมพ์ชื่อ ==========
local DonateUI = Instance.new("ScreenGui")
DonateUI.Name = "FakeDonateUI"
DonateUI.Parent = PlayerGui

local Notice = Instance.new("TextLabel")
Notice.Size = UDim2.new(0, 360, 0, 80)
Notice.Position = UDim2.new(0.02, 0, 0.02, 0)
Notice.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
Notice.BorderSizePixel = 3
Notice.BorderColor3 = Color3.fromRGB(255, 215, 0)
Notice.Font = Enum.Font.GothamBold
Notice.TextColor3 = Color3.new(1, 1, 1)
Notice.TextSize = 20
Notice.Text = "💖 กรุณาพิมพ์ชื่อคนที่ต้องการโดเนทให้"
Notice.Parent = DonateUI

local InputBox = Instance.new("TextBox")
InputBox.Size = UDim2.new(0, 280, 0, 50)
InputBox.Position = UDim2.new(0.02, 0, 0.15, 0)
InputBox.BackgroundColor3 = Color3.fromRGB(60, 60, 90)
InputBox.BorderSizePixel = 2
InputBox.BorderColor3 = Color3.fromRGB(150, 150, 255)
InputBox.Font = Enum.Font.Gotham
InputBox.TextColor3 = Color3.new(1, 1, 1)
InputBox.TextSize = 20
InputBox.Text = "พิมพ์ชื่อตรงนี้..."
InputBox.ClearTextOnFocus = true
InputBox.Parent = DonateUI

local SubmitBtn = Instance.new("TextButton")
SubmitBtn.Size = UDim2.new(0, 160, 0, 50)
SubmitBtn.Position = UDim2.new(0.02, 0, 0.26, 0)
SubmitBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
SubmitBtn.Font = Enum.Font.GothamBold
SubmitBtn.TextColor3 = Color3.new(1, 1, 1)
SubmitBtn.TextSize = 20
SubmitBtn.Text = "✨ โดเนท 1,000,000,000"
SubmitBtn.Parent = DonateUI

-- กดส่ง
SubmitBtn.MouseButton1Click:Connect(function()
	local name = InputBox.Text
	if name == "" or name == "พิมพ์ชื่อตรงนี้..." then
		Notice.Text = "⚠️ กรุณาพิมพ์ชื่อก่อนนะ!"
		Notice.BackgroundColor3 = Color3.fromRGB(150, 80, 40)
		task.wait(2)
		Notice.Text = "💖 กรุณาพิมพ์ชื่อคนที่ต้องการโดเนทให้"
		Notice.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
		return
	end
	ReplicatedStorage:WaitForChild("FakeDonateNameEvent"):FireServer(name, 1000000000)
	Notice.Text = "✅ ส่งให้ " .. name .. " แล้ว!"
	Notice.BackgroundColor3 = Color3.fromRGB(40, 120, 80)
	task.wait(2)
	Notice.Text = "💖 กรุณาพิมพ์ชื่อคนที่ต้องการโดเนทให้"
	Notice.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
	InputBox.Text = ""
end)

-- รับแจ้งเตือน
local Event = ReplicatedStorage:WaitForChild("FakeDonateEvent")
Event.OnClientEvent:Connect(function(name, amount)
	Notice.Text = "💖 " .. name .. " โดเนท " .. amount .. " โรบัค!"
	Notice.BackgroundColor3 = Color3.fromRGB(35, 100, 60)
	task.wait(4)
	Notice.Text = "💖 กรุณาพิมพ์ชื่อคนที่ต้องการโดเนทให้"
	Notice.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
end)
