local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local MarketplaceService = game:GetService("MarketplaceService")

local LP = Players.LocalPlayer

-- ค่าเริ่มต้นของ Robux ที่เสกไว้
local fakeRobuxBalance = 999999
local isFlying = false
local bodyVelocity, bodyGyro = nil, nil
local flySpeed = 60

-- ==================== [ SYSTEM FUNCTIONS ] ====================

-- ฟังก์ชั่นแปลงตัวเลขให้มีคอมม่า (เช่น 50000 -> 50,000)
local function formatNumber(n)
	return tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

-- 1. ระบบดักจับและเปลี่ยนเลข Robux บน Purchase Prompt จริงของ Roblox
local function hookRobloxPurchasePrompt()
	task.spawn(function()
		while true do
			task.wait(0.1)
			-- สแกนหา Roblox CoreGui Purchase Prompt
			local robloxGui = CoreGui:FindFirstChild("RobloxGui")
			if robloxGui then
				local purchasePrompt = robloxGui:FindFirstChild("PurchasePrompt") or robloxGui:FindFirstChild("PurchasePromptApp")
				if purchasePrompt then
					-- ค้นหา TextLabel ที่แสดง Robux balance ทั้งหมดในหน้าต่าง
					for _, descendant in ipairs(purchasePrompt:GetDescendants()) do
						if descendant:IsA("TextLabel") then
							-- ดักจับ Label ที่มีตัวเลขยอดเงินของผู้เล่น หรือ Label Robux
							if descendant.Name == "BalanceLabel" or descendant.Name == "RobuxBalance" or descendant.Name == "BalanceText" or string.find(descendant.Text, "^%d+$") then
								descendant.Text = formatNumber(fakeRobuxBalance)
							end
						end
					end
				end
			end
			
			-- รองรับกรณี PlayerGui Custom Prompt ในบางเกม
			local playerGui = LP:FindFirstChild("PlayerGui")
			if playerGui then
				for _, gui in ipairs(playerGui:GetChildren()) do
					if gui:IsA("ScreenGui") and gui.Name ~= "PrivateAIChatGui" then
						for _, descendant in ipairs(gui:GetDescendants()) do
							if descendant:IsA("TextLabel") and (descendant.Name == "RobuxBalance" or descendant.Name == "Balance") then
								descendant.Text = formatNumber(fakeRobuxBalance)
							end
						end
					end
				end
			end
		end
	end)
end

-- เริ่มการดักจับหน้าต่างซื้อสินค้าจริงทันที
hookRobloxPurchasePrompt()

-- 2. ระบบบิน / ลอย
local function setFly(state, speed)
	if speed then flySpeed = speed end
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	local hum = char:FindFirstChildOfClass("Humanoid")

	if state then
		if isFlying then return end
		isFlying = true
		if hum then hum.PlatformStand = true end

		bodyVelocity = Instance.new("BodyVelocity", hrp)
		bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
		bodyVelocity.Velocity = Vector3.zero

		bodyGyro = Instance.new("BodyGyro", hrp)
		bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 100000
		bodyGyro.CFrame = hrp.CFrame

		task.spawn(function()
			while isFlying and char and hrp do
				local camera = workspace.CurrentCamera
				local moveDir = hum and hum.MoveDirection or Vector3.zero
				if moveDir.Magnitude > 0 then
					bodyVelocity.Velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z)) * flySpeed
				else
					bodyVelocity.Velocity = Vector3.zero
				end
				bodyGyro.CFrame = camera.CFrame
				RunService.RenderStepped:Wait()
			end
		end)
	else
		isFlying = false
		if hum then hum.PlatformStand = false end
		if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	end
end

-- Variables สำหรับระบบ UI แชทส่วนตัว
local addChatMessage = function(sender, text, color) end

-- ==================== [ HIGH-INTELLIGENCE AI PROCESSOR ] ====================

local function processAICommand(msg)
	local text = string.lower(msg)
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	-- ดึงตัวเลขแรกที่พบในข้อความ
	local numberInput = tonumber(string.match(text, "%d+%.?%d*"))

	-- A. หมวดเสก Robux ปลอม (บันทึกยอดเงินไว้ในระบบ)
	if string.find(text, "โรบัค") or string.find(text, "โรบัก") or string.find(text, "robux") or string.find(text, "เสก") or string.find(text, "ตัง") or string.find(text, "เงิน") then
		local amount = numberInput or 999999
		fakeRobuxBalance = amount
		addChatMessage("AI", "ตั้งค่ายอด Robux ปลอมเป็น " .. formatNumber(amount) .. " R$ เรียบร้อย! เมื่อคุณไปกดซื้อของในเกม เลขนี้จะขึ้นที่มุมขวาบนของหน้าต่างซื้อจริงทันทีครับ", Color3.fromRGB(0, 255, 127))

	-- B. หมวดการบิน / ลอย
	elseif string.find(text, "บิน") or string.find(text, "ลอย") or string.find(text, "เหาะ") or string.find(text, "fly") then
		if string.find(text, "หยุด") or string.find(text, "เลิก") or string.find(text, "ปิด") or string.find(text, "ลง") or string.find(text, "off") then
			setFly(false)
			addChatMessage("AI", "ปิดโหมดบินเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 60
			setFly(true, spd)
			addChatMessage("AI", "เปิดโหมดบินความเร็ว " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- C. หมวดความเร็วการเดิน/วิ่ง
	elseif string.find(text, "วิ่ง") or string.find(text, "เดิน") or string.find(text, "สปีด") or string.find(text, "เร็ว") or string.find(text, "ไว") or string.find(text, "speed") then
		if string.find(text, "ปกติ") or string.find(text, "ช้า") or string.find(text, "เดิม") then
			if hum then hum.WalkSpeed = 16 end
			addChatMessage("AI", "รีเซ็ตความเร็วกลับเป็นปกติ (16) แล้วครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 100
			if hum then hum.WalkSpeed = spd end
			addChatMessage("AI", "ปรับความเร็วการวิ่งเป็น " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- D. หมวดการกระโดด
	elseif string.find(text, "โดด") or string.find(text, "เด้ง") or string.find(text, "สูง") or string.find(text, "jump") then
		if string.find(text, "ปกติ") then
			if hum then hum.JumpPower = 50 end
			addChatMessage("AI", "ปรับแรงกระโดดกลับเป็นปกติ (50) แล้วครับ", Color3.fromRGB(255, 200, 100))
		else
			local jp = numberInput or 150
			if hum then hum.UseJumpPower = true hum.JumpPower = jp end
			addChatMessage("AI", "ปรับแรงกระโดดเป็น " .. jp .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- E. หมวดขนาดตัวละคร
	elseif string.find(text, "ใหญ่") or string.find(text, "ยักษ์") or string.find(text, "เล็ก") or string.find(text, "ย่อ") or string.find(text, "ตัว") or string.find(text, "ขนาด") then
		local scale = numberInput or (string.find(text, "เล็ก") and 0.5 or 2)
		if hum then
			for _, prop in ipairs({"BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale"}) do
				local s = hum:FindFirstChild(prop)
				if s then s.Value = scale end
			end
		end
		addChatMessage("AI", "ปรับขนาดตัวละครเป็น " .. scale .. " เท่าเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))

	-- F. หมวดวาร์ป
	elseif string.find(text, "วาป") or string.find(text, "วาร์ป") or string.find(text, "ไป") or string.find(text, "ขึ้น") or string.find(text, "tp") then
		local dist = numberInput or 50
		if hrp then
			if string.find(text, "ฟ้า") or string.find(text, "สูง") or string.find(text, "บน") then
				hrp.CFrame = hrp.CFrame + Vector3.new(0, dist, 0)
				addChatMessage("AI", "วาร์ปขึ้นฟ้า " .. dist .. " หน่วยเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
			else
				hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * dist)
				addChatMessage("AI", "วาร์ปไปข้างหน้า " .. dist .. " หน่วยเรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
			end
		end

	-- G. หมวดเดินทะลุสิ่งกีดขวาง (Noclip)
	elseif string.find(text, "ทะลุ") or string.find(text, "noclip") then
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
		addChatMessage("AI", "เปิดโหมดเดินทะลุสิ่งกีดขวางแล้วครับ", Color3.fromRGB(100, 255, 100))

	-- H. หมวดรีเซ็ตสถานะ
	elseif string.find(text, "รี") or string.find(text, "ปกติ") or string.find(text, "เดิม") or string.find(text, "reset") then
		setFly(false)
		if hum then
			hum.WalkSpeed = 16
			hum.JumpPower = 50
			for _, prop in ipairs({"BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale"}) do
				local s = hum:FindFirstChild(prop)
				if s then s.Value = 1 end
			end
		end
		addChatMessage("AI", "รีเซ็ตสถานะตัวละครกลับเป็นปกติเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))

	-- กรณีป้อนตัวเลขมาเฉยๆ เช่น "50000" หรือ "9000"
	elseif numberInput then
		fakeRobuxBalance = numberInput
		addChatMessage("AI", "อัปเดต Robux ปลอมเป็น " .. formatNumber(numberInput) .. " R$ เรียบร้อยครับ!", Color3.fromRGB(0, 255, 127))
	else
		addChatMessage("AI", "ฉันไม่เข้าใจคำสั่งนี้ ลองพิมพ์คำสั่งง่ายๆ เช่น 'เสก 50000', 'บิน', 'วิ่งเร็ว 100' ได้เลยครับ", Color3.fromRGB(255, 100, 100))
	end
end

-- ==================== [ PRIVATE AI CHAT GUI ] ====================

local function createPrivateChatUI()
	local playerGui = LP:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild("PrivateAIChatGui")
	if existing then existing:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PrivateAIChatGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	-- กรอบหลักของกล่องแชท
	local mainFrame = Instance.new("Frame")
	mainFrame.Name = "MainFrame"
	mainFrame.Size = UDim2.new(0, 320, 0, 240)
	mainFrame.Position = UDim2.new(0, 20, 0.5, -120)
	mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	mainFrame.BackgroundTransparency = 0.15
	mainFrame.ClipsDescendants = true
	mainFrame.Parent = screenGui
	Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)

	local uiStroke = Instance.new("UIStroke", mainFrame)
	uiStroke.Color = Color3.fromRGB(0, 170, 255)
	uiStroke.Thickness = 1.5

	-- แถบหัวเรื่อง (Title Bar)
	local titleBar = Instance.new("TextLabel")
	titleBar.Size = UDim2.new(1, 0, 0, 30)
	titleBar.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	titleBar.Text = "  🤖 Private AI Assistant"
	titleBar.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleBar.Font = Enum.Font.FredokaOne
	titleBar.TextSize = 14
	titleBar.TextXAlignment = Enum.TextXAlignment.Left
	titleBar.Parent = mainFrame

	-- ช่องแสดงประวัติแชท (ScrollingFrame)
	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Size = UDim2.new(0.94, 0, 0.65, 0)
	scrollFrame.Position = UDim2.new(0.03, 0, 0.15, 0)
	scrollFrame.BackgroundTransparency = 1
	scrollFrame.ScrollBarThickness = 4
	scrollFrame.Parent = mainFrame

	local uiListLayout = Instance.new("UIListLayout")
	uiListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	uiListLayout.Padding = UDim.new(0, 5)
	uiListLayout.Parent = scrollFrame

	-- ช่องพิมพ์ข้อความ (TextBox)
	local inputFrame = Instance.new("Frame")
	inputFrame.Size = UDim2.new(0.94, 0, 0.15, 0)
	inputFrame.Position = UDim2.new(0.03, 0, 0.82, 0)
	inputFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	inputFrame.Parent = mainFrame
	Instance.new("UICorner", inputFrame).CornerRadius = UDim.new(0, 6)

	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.75, 0, 1, 0)
	textBox.Position = UDim2.new(0.03, 0, 0, 0)
	textBox.BackgroundTransparency = 1
	textBox.PlaceholderText = "พิมพ์สั่ง AI ที่นี่..."
	textBox.Text = ""
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.Font = Enum.Font.SourceSans
	textBox.TextSize = 14
	textBox.TextXAlignment = Enum.TextXAlignment.Left
	textBox.Parent = inputFrame

	local sendBtn = Instance.new("TextButton")
	sendBtn.Size = UDim2.new(0.2, 0, 0.8, 0)
	sendBtn.Position = UDim2.new(0.78, 0, 0.1, 0)
	sendBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	sendBtn.Text = "ส่ง"
	sendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	sendBtn.Font = Enum.Font.FredokaOne
	sendBtn.TextSize = 13
	sendBtn.Parent = inputFrame
	Instance.new("UICorner", sendBtn).CornerRadius = UDim.new(0, 4)

	-- ฟังก์ชั่นเพิ่มข้อความเข้าในกล่องแชท
	addChatMessage = function(sender, text, color)
		local msgLabel = Instance.new("TextLabel")
		msgLabel.Size = UDim2.new(1, 0, 0, 0)
		msgLabel.BackgroundTransparency = 1
		msgLabel.Text = "<b>" .. sender .. ":</b> " .. text
		msgLabel.RichText = true
		msgLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
		msgLabel.Font = Enum.Font.SourceSans
		msgLabel.TextSize = 14
		msgLabel.TextWrapped = true
		msgLabel.TextXAlignment = Enum.TextXAlignment.Left
		msgLabel.Parent = scrollFrame

		-- ปรับขนาดความสูงตามข้อความอัตโนมัติ
		msgLabel.Size = UDim2.new(1, 0, 0, msgLabel.TextBounds.Y + 2)
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y + 10)
		scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
	end

	-- ระบบการส่งข้อความ
	local function onSend()
		local text = textBox.Text
		if text ~= "" then
			textBox.Text = ""
			addChatMessage("คุณ", text, Color3.fromRGB(200, 220, 255))
			processAICommand(text)
		end
	end

	sendBtn.MouseButton1Click:Connect(onSend)
	textBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then onSend() end
	end)

	-- ระบบลากกล่องแชทส่วนตัวย้ายตำแหน่ง (Draggable UI)
	local dragging, dragInput, dragStart, startPos
	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	titleBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	-- ข้อความต้อนรับ
	addChatMessage("AI", "พร้อมใช้งานครับ! ลองพิมพ์ว่า 'เสกโรบัค 50000' แล้วไปกดซื้อของในเกมได้เลยครับ", Color3.fromRGB(150, 220, 255))
end

-- ==================== [ EXECUTION ] ====================

LP.CharacterAdded:Connect(function() setFly(false) end)
createPrivateChatUI()
