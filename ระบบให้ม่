-- ฟังก์ชันสร้างป้ายชื่อบนหัว
local function createCustomNameTag(character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	if head:FindFirstChild("GlobalNameTag") then
		head.GlobalNameTag:Destroy()
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GlobalNameTag"
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = head

	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "NameDisplay"
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = LP.DisplayName or LP.Name
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 16
	textLabel.Font = Enum.Font.SourceSansBold
	textLabel.Parent = billboard

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Parent = textLabel

	billboard.Parent = head
end

