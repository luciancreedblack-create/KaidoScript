	-- ==========================================
	-- ระบบบินใหม่ล่าสุด รองรับฟิสิกส์ Roblox ปัจจุบัน (LinearVelocity & AlignOrientation)
	-- ==========================================
	local function triggerFly()
		pcall(function()
			local char = LP.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not root or not hum then return end

			-- ถ้ามีระบบบินอยู่แล้ว ให้ทำการปิด (Toggle Off)
			if char:FindFirstChild("ModernFlyAttachment") then
				char.ModernFlyAttachment:Destroy()
				if char:FindFirstChild("HumanoidRootPart") then
					for _, v in pairs(char.HumanoidRootPart:GetChildren()) do
						if v.Name == "GalaxyLinearVel" or v.Name == "GalaxyAlignGyro" or v.Name == "GalaxyAttach" then
							v:Destroy()
						end
					end
				end
				hum.PlatformStand = false
				return
			end

			hum.PlatformStand = true

			local attachment = Instance.new("Attachment")
			attachment.Name = "GalaxyAttach"
			attachment.Parent = root

			local linearVel = Instance.new("LinearVelocity")
			linearVel.Name = "GalaxyLinearVel"
			linearVel.Attachment0 = attachment
			linearVel.MaxForce = math.huge
			linearVel.VectorVelocity = Vector3.new(0, 0, 0)
			linearVel.RelativeTo = Enum.ActuatorRelativeTo.World
			linearVel.Parent = root

			local alignGyro = Instance.new("AlignOrientation")
			alignGyro.Name = "GalaxyAlignGyro"
			alignGyro.Attachment0 = attachment
			alignGyro.MaxTorque = math.huge
			alignGyro.Responsiveness = 200
			alignGyro.Parent = root

			task.spawn(function()
				while char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("GalaxyLinearVel") do
					local cam = workspace.CurrentCamera
					local speed = 60
					local moveV = Vector3.new(0, 0, 0)

					if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveV = moveV + cam.CFrame.LookVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveV = moveV - cam.CFrame.LookVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveV = moveV - cam.CFrame.RightVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveV = moveV + cam.CFrame.RightVector end

					linearVel.VectorVelocity = moveV * speed
					alignGyro.CFrame = cam.CFrame
					task.wait()
				end
				if hum then
					hum.PlatformStand = false
				end
			end)
		end)
	end

	-- ฟังก์ชันประมวลผล AI
	local function processAICommand(rawText)
		if rawText == "" then return end
		chatLog.Text = chatLog.Text .. "\n\n👤 คำสั่ง: " .. rawText
		aiTextBox.Text = ""

		task.delay(0.3, function()
			local lower = rawText:lower()
			local reply = "Samsung AI: ประมวลผลคำสั่งสำเร็จ!"

			if lower:find("บิน") or lower:find("fly") or lower:find("ลอย") then
				triggerFly()
				reply = "Samsung AI: เปิด/ปิด ระบบบินเวอร์ชันใหม่สำเร็จ! ใช้ W A S D ควบคุมทิศทาง"
			elseif lower:find("เร็ว") or lower:find("speed") or lower:find("วิ่ง") then
				pcall(function() LP.Character.Humanoid.WalkSpeed = 100 end)
				reply = "Samsung AI: เร่งความเร็วสำเร็จ!"
			elseif lower:find("อมตะ") or lower:find("เลือด") or lower:find("god") then
				pcall(function() LP.Character.Humanoid.MaxHealth = math.huge LP.Character.Humanoid.Health = math.huge end)
				reply = "Samsung AI: เปิดโหมดอมตะสำเร็จ!"
			else
				reply = "Samsung AI: จัดการคำสั่ง '" .. rawText .. "' เรียบร้อย!"
			end

			chatLog.Text = chatLog.Text .. "\n\n🤖 " .. reply
		end)
	end

