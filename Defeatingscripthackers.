-- ==========================================
-- ส่วนที่ 2: ระบบฝั่ง Client (เอฟเฟกต์หน้าจอและเลือกเป้าหมาย)
-- ==========================================
else
    local player = Players.LocalPlayer
    local mouse = player:GetMouse()

    local function showKingSkillVisual(playerName, skillName, color, skillType)
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "KingSkillEffectGUI"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = player:WaitForChild("PlayerGui")

        -- แฟลชแสงอลังการทั่วหน้าจอ
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = color
        frame.BackgroundTransparency = 0.4
        frame.Parent = screenGui

        -- ป้ายชื่อสกิลราชาตรงกลางจอให้ทุกคนเห็น
        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(0, 900, 0, 180)
        textLabel.Position = UDim2.new(0.5, -450, 0.35, -90)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.GothamBlack
        textLabel.Text = "👑 " .. skillName .. " 👑\n[ ผู้ใช้พลัง: " .. playerName .. " ]"
        textLabel.Parent = screenGui

        -- ลบเอฟเฟกต์อัตโนมัติหลัง 3.5 วินาที
        task.delay(3.5, function()
            screenGui:Destroy()
        end)
        
        -- ถ้าใช้สกิลที่ 1 (หยุดเวลา & เตะโปร) และเราคือคนใช้ ให้คลิกเล็งเป้าหมายที่ใช้โปร
        if skillType == "kick_exploit" and playerName == player.Name then
            local targetChar = mouse.Target
            if targetChar and targetChar.Parent then
                local humanoid = targetChar.Parent:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local targetPlayer = Players:GetPlayerFromCharacter(humanoid.Parent)
                    if targetPlayer then
                        remoteEvent:FireServer(targetPlayer, "kick_exploit")
                    end
                end
            end
        end
    end

    remoteEvent.OnClientEvent:Connect(function(playerName, skillName, color, skillType)
        showKingSkillVisual(playerName, skillName, color, skillType)
    end)
