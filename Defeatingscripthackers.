    -- รับคำสั่งเตะผู้เล่นเป้าหมายจริงจาก Client (เฉพาะสกิลที่ 1)
    remoteEvent.OnServerEvent:Connect(function(attacker, targetPlayer, skillType)
        if skillType == "kick_exploit" and targetPlayer and targetPlayer:IsA("Player") and targetPlayer ~= attacker then
            local banDuration = 30 * 60 -- แบน 30 นาที
            bannedExploiters[targetPlayer.UserId] = os.time() + banDuration
            
            targetPlayer:Kick("👑 [ANTI-EXPLOIT KICK]: คุณถูกราชันย์ " .. attacker.Name .. " ตรวจพบโปรแกรมโกงและเตะออกจากแมพ!\nห้ามเข้าเกมนี้เป็นเวลา 30 นาที")
