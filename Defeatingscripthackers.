-- สร้าง RemoteEvent สำหรับประสานงาน Server และ Client
local remoteEvent = ReplicatedStorage:FindFirstChild("GuardianKingEvent")
if not remoteEvent then
    remoteEvent = Instance.new("RemoteEvent")
    remoteEvent.Name = "GuardianKingEvent"
    remoteEvent.Parent = ReplicatedStorage
end

-- ตารางเก็บบันทึกเวลาแบน 30 นาที สำหรับโปรแกรมโกง
local bannedExploiters = {}

-- ตรวจสอบเวลาแบนตอนเข้าเกม
Players.PlayerAdded:Connect(function(player)
    local userId = player.UserId
    local currentTime = os.time()
    
    if bannedExploiters[userId] and currentTime < bannedExploiters[userId] then
        local timeLeft = math.ceil((bannedExploiters[userId] - currentTime) / 60)
        player:Kick("👑 [KING'S JUSTICE]: คุณถูกราชันย์พิพากษาแบนเนื่องจากใช้โปรแกรมโกง! ต้องรออีก " .. timeLeft .. " นาที ถึงจะเข้าเกมได้")
    else
        bannedExploiters[userId] = nil
    end
end)

