local Players = game:GetService("Players")
local LP = Players.LocalPlayer

-- 1. สร้าง Overhead บนหัว
local function setupOverhead(char)
	local head = char:WaitForChild("Head", 5)
	if not head or head:FindFirstChild("MyOverhead") then return end

	local bb = Instance.new("BillboardGui", head)
	bb.Name, bb.Size, bb.StudsOffset, bb.AlwaysOnTop = "MyOverhead", UDim2.new(0, 200, 0, 50), Vector3.new(0, 2.8, 0), true

	local txt = Instance.new("TextLabel", bb)
	txt.Name, txt.Size, txt.BackgroundTransparency = "DisplayLabel", UDim2.new(1, 0, 1, 0), 1
	txt.Text, txt.TextColor3, txt.TextScaled, txt.Font = "ข้อความที่ต้องการใส่", Color3.fromRGB(255, 215, 0), true, Enum.Font.FredokaOne

	local stroke = Instance.new("UIStroke", txt)
	stroke.Color, stroke.Thickness = Color3.fromRGB(0, 0, 0), 2
end

-- 2. สร้าง UI พิมพ์เปลี่ยนชื่อ
local function createUI()
	local gui = Instance.new("ScreenGui", LP:WaitForChild("PlayerGui"))
	gui.Name, gui.ResetOnSpawn = "NameChangerGui", false

	local frame = Instance.new("Frame", gui)
	frame.Size, frame.Position = UDim2.new(0, 260, 0, 80), UDim2.new(0.5, -130, 0.85, 0)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

	local box = Instance.new("TextBox", frame)
	box.Size, box.Position = UDim2.new(0.9, 0, 0.4, 0), UDim2.new(0.05, 0, 0.1, 0)
	box.PlaceholderText, box.Text, box.TextScaled = "พิมพ์ชื่อใหม่...", "", true
	box.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	Instance.new("UICorner", box)

	local btn = Instance.new("TextButton", frame)
	btn.Size, btn.Position = UDim2.new(0.9, 0, 0.35, 0), UDim2.new(0.05, 0, 0.55, 0)
	btn.Text, btn.BackgroundColor3, btn.TextScaled = "เปลี่ยนชื่อ", Color3.fromRGB(255, 215, 0), true
	Instance.new("UICorner", btn)

	btn.MouseButton1Click:Connect(function()
		if box.Text ~= "" and LP.Character and LP.Character:FindFirstChild("Head") then
			local label = LP.Character.Head:FindFirstChild("MyOverhead") and LP.Character.Head.MyOverhead:FindFirstChild("DisplayLabel")
			if label then label.Text = box.Text end
		end
	end)
end

LP.CharacterAdded:Connect(setupOverhead)
if LP.Character then task.spawn(setupOverhead, LP.Character) end
createUI()
