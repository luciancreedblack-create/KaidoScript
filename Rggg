-- [[ Put this LocalScript in StarterPlayer -> StarterPlayerScripts ]] --

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LP = Players.LocalPlayer

-- 1. ฟังก์ชันสร้างป้ายชื่อบนหัว (ใช้ฟอนต์มาตรฐาน Roblox ตัวเล็กๆ คมๆ แบบผู้เล่นคนอื่น)
local function setupRobloxStyleTag(character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	-- ลบป้ายเก่าทิ้งก่อนกันซ้ำ
	local oldTag = head:FindFirstChild("RobloxNameTag")
	if oldTag then oldTag:Destroy() end

	-- สร้าง BillboardGui
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "RobloxNameTag"
	billboard.Size = UDim2.new(0, 200, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = head

	-- สร้าง TextLabel (ฟอนต์ SourceSansBold ตัวเล็กสไตล์ Roblox ดั้งเดิม + ขอบดำบางๆ ให้มองเห็นชัด)
	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "NameLabel"
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = LP.Name -- ค่าเริ่มต้นเป็นชื่อของคุณ
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 18
	textLabel.Font = Enum.Font.SourceSansBold
	textLabel.Parent = billboard

	-- ใส่ขอบดำบางๆ เพื่อความคมชัดแบบป้ายชื่อเกมทั่วไป
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Parent = textLabel

	billboard.Parent = head
end

-- 2. ระบบสร้าง UI เมนูพิมพ์เปลี่ยนชื่อ (ลากย้ายตำแหน่งได้)
local function createDraggableUI()
	local playerGui = LP:WaitForChild("PlayerGui")
	local existingGui = playerGui:FindFirstChild("NameChangerGui")
	if existingGui then existingGui:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "NameChangerGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	-- กรอบเมนูหลัก
	local frame = Instance.new("Frame")
	frame.Name = "MainFrame"
	frame.Size = UDim2.new(0, 260, 0, 90)
	frame.Position = UDim2.new(0.5, -130, 0.82, 0)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	frame.BackgroundTransparency = 0.15
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

	local frameStroke = Instance.new("UIStroke")
	frameStroke.Color = Color3.fromRGB(255, 255, 255)
	frameStroke.Thickness = 1.5
	frameStroke.Parent = frame

	-- ช่องพิมพ์ข้อความ
	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.9, 0, 0.4, 0)
	textBox.Position = UDim2.new(0.05, 0, 0.1, 0)
	textBox.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	textBox.PlaceholderText = "พิมพ์ชื่อใหม่..."
	textBox.Text = ""
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.TextSize = 16
	textBox.Font = Enum.Font.SourceSansBold
	textBox.Parent = frame
	Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 6)

	-- ปุ่มกดตกลง
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0.9, 0, 0.35, 0)
	button.Position = UDim2.new(0.05, 0, 0.55, 0)
	button.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	button.Text = "เปลี่ยนชื่อ"
	button.TextColor3 = Color3.fromRGB(0, 0, 0)
	button.TextSize = 16
	button.Font = Enum.Font.SourceSansBold
	button.Parent = frame
	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

	-- ปุ่มกดเปลี่ยนชื่อ (อัปเดตชื่อบนหัวทันที)
	button.MouseButton1Click:Connect(function()
		local newText = textBox.Text
		if newText ~= "" and LP.Character and LP.Character:FindFirstChild("Head") then
			local head = LP.Character.Head
			local tag = head:FindFirstChild("RobloxNameTag")
			if tag and tag:FindFirstChild("NameLabel") then
				tag.NameLabel.Text = newText
			end
			-- อัปเดต DisplayName เผื่อระบบเกมรองรับด้วย
			local humanoid = LP.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.DisplayName = newText
			end
		end
	end)

	-- ระบบลากกล่องย้ายตำแหน่ง (Draggable Logic)
	local dragging, dragInput, dragStart, startPos
	local function update(input)
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)

	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then update(input) end
	end)
end

-- ==================== [ EXECUTION ] ====================
LP.CharacterAdded:Connect(setupRobloxStyleTag)
if LP.Character then
	task.spawn(setupRobloxStyleTag, LP.Character)
end

createDraggableUI()
                                        
