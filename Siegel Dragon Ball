-- 3. ฟังก์ชันสร้างออร่าพลังงานและแอนิเมชั่นต่อสู้สมจริง 1000%
local function activateUltimateCombatMode()
	if not character then return end
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	
	if not humanoidRootPart or not humanoid then return end
	
	-- สร้างออร่าพาร์ติเคิลพลังงานเข้มข้นรอบตัว
	local attachment = Instance.new("Attachment")
	attachment.Name = "ProCombatAura"
	attachment.Parent = humanoidRootPart
	
	-- ออร่าแสงสีฟ้าคราม/เขียวมิอนพุ่งทะยาน
	local auraParticle = Instance.new("ParticleEmitter")
	auraParticle.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 200)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 100, 255))
	})
	auraParticle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 3),
		NumberSequenceKeypoint.new(0.5, 6),
		NumberSequenceKeypoint.new(1, 1)
	})
	auraParticle.Texture = "rbxassetid://258129463"
	auraParticle.Lifetime = NumberRange.new(0.3, 0.6)
	auraParticle.Rate = 250
	auraParticle.Speed = NumberRange.new(12, 30)
	auraParticle.EmissionDirection = Enum.NormalId.Top
	auraParticle.Parent = attachment
	
	-- ประกายแสงไฟนีออนรอบตัว
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(0, 255, 200)
	light.Range = 30
	light.Brightness = 12
	light.Parent = humanoidRootPart
	
	-- ระบบเล่นแอนิเมชั่นท่ายืนเตรียมพร้อมต่อสู้ (Combat Stance Animation)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	
	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://507777268" -- ID แอนิเมชั่นท่าต่อสู้/ตั้งการ์ด
	local animTrack = animator:LoadAnimation(animation)
	animTrack:Play()
	
	-- บัฟความสามารถตัวละครให้รวดเร็วและทรงพลัง
	humanoid.WalkSpeed = 50
	humanoid.JumpPower = 130
	
	print(">>> [COMBAT MODE] เปิดใช้งานโหมดต่อสู้ขั้นสุดยอด สมจริง 1000% เต็มระบบ!")
end

-- 4. ฟังก์ชันพุ่งตัวโจมตีคอมโบ (Dash Combo Attack)
local function executeDashCombo()
	if not character then return end
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	print(">>> พุ่งตัวออกท่าคอมโบโจมตีความเร็วสูง!")
	
	-- สร้างแรงพุ่งตัวไปข้างหน้า
	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(50000, 0, 50000)
	bodyVelocity.Velocity = humanoidRootPart.CFrame.LookVector * 80
	bodyVelocity.Parent = humanoidRootPart
	
	task.wait(0.35)
	bodyVelocity:Destroy()
end

