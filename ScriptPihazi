-- [[ Put this LocalScript in StarterPlayer -> StarterPlayerScripts ]] --

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LP = Players.LocalPlayer

-- 1. ฟังก์ชันอัปเดต DisplayName ให้ตัวละครปัจจุบันและตัวต่อๆ ไป (เพื่อให้คนอื่นมองเห็นผ่านระบบ Roblox แท้)
local function applyDisplayName(character, newName)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid and newName ~= "" then
		humanoid.DisplayName = newName
	end
end

-- ติดตามเมื่อตัวละครเกิดใหม่
LP.CharacterAdded:Connect(function(character)
	-- ถ้ามีการตั้งชื่อค้างไว้ สามารถดึงมาใช้ต่อได้ หรือปล่อยเป็นค่าเดิม
	task.wait(0.5)
end)

-- 2. ระบบสร้าง UI เมนูพิมพ์เปลี่ยนชื่อ (ลากย้ายตำแหน่งได้)
local function createDraggableUI()
	local playerGui = LP:WaitForChild("PlayerGui")
	local existingGui = playerGui:FindFirstChild("NameChangerGui")
	if existingGui then existingGui:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "NameChangerGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	-- กรอบเมนูหลัก
	local frame = Instance.new("Frame")
	frame.Name = "MainFrame"
	frame.Size = UDim2.new(0, 260, 0, 90)
	frame.Position = UDim2.new(0.5, -130, 0.82, 0)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	frame.BackgroundTransparency = 0.15
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

	local frameStroke = Instance.new("UIStroke")
	frameStroke.Color = Color3.fromRGB(255, 255, 255)
	frameStroke.Thickness = 1.5
	frameStroke.Parent = frame

	-- ช่องพิมพ์ข้อความ
	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.9, 0, 0.4, 0)
	textBox.Position = UDim2.new(0.05, 0, 0.1, 0)
	textBox.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	textBox.PlaceholderText = "พิมพ์ชื่อใหม่..."
	textBox.Text = ""
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.TextScaled = true
	textBox.Font = Enum.Font.SourceSansBold
	textBox.Parent = frame
	Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 6)

	-- ปุ่มกดตกลง
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0.9, 0, 0.35, 0)
	button.Position = UDim2.new(0.05, 0, 0.55, 0)
	button.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	button.Text = "เปลี่ยนชื่อ"
	button.TextColor3 = Color3.fromRGB(0, 0, 0)
	button.TextScaled = true
	button.Font = Enum.Font.SourceSansBold
	button.Parent = frame
	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

	-- ปุ่มกดเปลี่ยนชื่อ (เปลี่ยนผ่าน Humanoid.DisplayName ทำให้ฟอนต์เป็นแบบ Roblox แท้ และคนอื่นมองเห็น)
	button.MouseButton1Click:Connect(function()
		local text = textBox.Text
		if text ~= "" and LP.Character then
			applyDisplayName(LP.Character, text)
		end
	end)

	-- ระบบลากกล่องย้ายตำแหน่ง (Draggable Logic)
	local dragging, dragInput, dragStart, startPos
	local function update(input)
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)

	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then update(input) end
	end)
end

-- ==================== [ EXECUTION ] ====================
createDraggableUI()
