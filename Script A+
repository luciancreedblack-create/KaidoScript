-- 3. ระบบวาร์ปไปยังตำแหน่ง/สิ่งของ/พิกัดที่กำหนดอัตโนมัติ
local function teleportToTarget(targetInput)
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return false, "ไม่พบตัวละครของคุณ" end
	local hrp = char.HumanoidRootPart

	-- กรณี A: ระบุพิกัด X Y Z (เช่น "วาร์ป 100 50 -200")
	local x, y, z = string.match(targetInput, "(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)")
	if x and y and z then
		hrp.CFrame = CFrame.new(tonumber(x), tonumber(y), tonumber(z))
		return true, "วาร์ปไปพิกัด (" .. x .. ", " .. y .. ", " .. z .. ") เรียบร้อยครับ!"
	end

	-- กรณี B: วาร์ปไปหาผู้เล่นคนอื่นในแมพ
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP and string.find(string.lower(player.Name), string.lower(targetInput)) then
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				hrp.CFrame = player.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
				return true, "วาร์ปไปหาผู้เล่น " .. player.Name .. " เรียบร้อยครับ!"
			end
		end
	end

	-- กรณี C: ค้นหาวัตถุใน Workspace ตามชื่อ
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Model") then
			if string.find(string.lower(obj.Name), string.lower(targetInput)) then
				local targetCFrame = obj:IsA("Model") and obj:GetPivot() or obj.CFrame
				hrp.CFrame = targetCFrame + Vector3.new(0, 4, 0)
				return true, "วาร์ปไปตำแหน่ง " .. obj.Name .. " เรียบร้อยครับ!"
			end
		end
	end

	return false, "ไม่พบตำแหน่งหรือผู้เล่นที่ระบุครับ"
end

-- 4. ระบบบินไปยังเส้นชัยอัตโนมัติ (Auto-Fly to Victory)
local function flyToVictory()
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	local hum = char:FindFirstChildOfClass("Humanoid")

	-- ค้นหาจุด Victory / Win / Finish
	local winPart = nil
	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("BasePart") or item:IsA("Model") then
			local name = string.lower(item.Name)
			if string.find(name, "win") or string.find(name, "victory") or string.find(name, "finish") or string.find(name, "end") or string.find(name, "ชัยชนะ") then
				winPart = item
				break
			end
		end
	end

	local targetPos = winPart and (winPart:IsA("Model") and winPart:GetPivot().Position or winPart.Position) or (hrp.Position + Vector3.new(0, 300, 0))

	task.spawn(function()
		if hum then hum.PlatformStand = true end

		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1, 1, 1) * 100000
		bv.Parent = hrp

		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(1, 1, 1) * 100000
		bg.Parent = hrp

		while char and char.Parent and hrp and (hrp.Position - targetPos).Magnitude > 5 do
			local direction = (targetPos - hrp.Position).Unit
			bv.Velocity = direction * 100
			bg.CFrame = CFrame.new(hrp.Position, targetPos)
			RunService.RenderStepped:Wait()
		end

		bv:Destroy()
		bg:Destroy()
		if hum then hum.PlatformStand = false end
		addChatMessage("AI", "🎉 บินถึงเส้นชัยเรียบร้อยแล้วครับ!", Color3.fromRGB(0, 255, 120))
	end)
end

-- 5. ระบบ AI เล่นอัตโนมัติ (Auto-Play)
local function startAIAutoPlay(state)
	autoPlayActive = state
	if not autoPlayActive then return end

	task.spawn(function()
		while autoPlayActive do
			task.wait(0.5)
			local char = LP.Character
			if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
				local hrp = char.HumanoidRootPart
				local hum = char:FindFirstChildOfClass("Humanoid")

				local targetPart = nil
				local minDistance = math.huge

				for _, part in ipairs(workspace:GetDescendants()) do
					if part:IsA("BasePart") then
						local name = string.lower(part.Name)
						if string.find(name, "stage") or string.find(name, "checkpoint") or string.find(name, "spawn") or string.find(name, "win") then
							local dist = (part.Position - hrp.Position).Magnitude
							if dist > 5 and dist < minDistance then
								minDistance = dist
								targetPart = part
							end
						end
					end
				end

				if targetPart then
					hum:MoveTo(targetPart.Position)
				else
					hum:MoveTo(hrp.Position + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)))
				end
			end
		end
	end)
end

-- 6. ระบบบินทั่วไป
local function setFly(state, speed)
	if speed then flySpeed = speed end
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	local hum = char:FindFirstChildOfClass("Humanoid")

	if state then
		if isFlying then return end
		isFlying = true
		if hum then hum.PlatformStand = true end

		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
		bodyVelocity.Velocity = Vector3.zero
		bodyVelocity.Parent = hrp

		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 100000
		bodyGyro.CFrame = hrp.CFrame
		bodyGyro.Parent = hrp

		task.spawn(function()
			while isFlying and char and char.Parent and hrp do
				local camera = workspace.CurrentCamera
				local moveDir = hum and hum.MoveDirection or Vector3.zero
				if moveDir.Magnitude > 0 then
					bodyVelocity.Velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z)) * flySpeed
				else
					bodyVelocity.Velocity = Vector3.zero
				end
				bodyGyro.CFrame = camera.CFrame
				RunService.RenderStepped:Wait()
			end
		end)
	else
		isFlying = false
		if hum then hum.PlatformStand = false end
		if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	end
end

