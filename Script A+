-- ==================== [ AUTO SPEECH TO TEXT SETUP ] ====================

local function setupSpeechToTextEngine()
	task.spawn(function()
		pcall(function()
			local char = LP.Character or LP.CharacterAdded:Wait()
			
			local audioDeviceInput = Instance.new("AudioDeviceInput")
			audioDeviceInput.Name = "AutoVoiceInput"
			audioDeviceInput.Player = LP
			audioDeviceInput.Parent = char

			local audioSpeechToText = Instance.new("AudioSpeechToText")
			audioSpeechToText.Name = "AutoSpeechToText"
			audioSpeechToText.Enabled = true
			audioSpeechToText.Parent = char

			local wire = Instance.new("Wire")
			wire.Name = "VoiceWire"
			wire.SourceInstance = audioDeviceInput
			wire.SourceName = "Output"
			wire.TargetInstance = audioSpeechToText
			wire.TargetName = "Input"
			wire.Parent = char

			audioSpeechToText:GetPropertyChangedSignal("Text"):Connect(function()
				local textResult = audioSpeechToText.Text
				if textResult and textResult ~= "" then
					addChatMessage("คุณ (พูด)", textResult, Color3.fromRGB(150, 255, 150))
					processAICommand(textResult)
				end
			end)
		end)
	end)
end

-- ==================== [ HIGH-IQ SMART AI CHATBOT & PROCESSOR ] ====================

processAICommand = function(msg)
	if not msg or msg == "" then return end
	local text = string.lower(msg)
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local numberInput = tonumber(string.match(text, "%d+%.?%d*"))

	-- A. ระบบ AFK เปิด/ปิด ป้ายบนหัว
	if string.find(text, "afk") or string.find(text, "ไม่อยู่") or string.find(text, "ไปธุระ") then
		if string.find(text, "เลิก") or string.find(text, "กลับมา") or string.find(text, "ปิด") then
			setAFKStatus(false)
			addChatMessage("AI", "ยินดีต้อนรับกลับมาครับ! ปิดสถานะ AFK เรียบร้อย", Color3.fromRGB(100, 255, 100))
		else
			setAFKStatus(true)
			addChatMessage("AI", "เปิดสถานะ AFK บนหัวเรียบร้อยครับ (ผู้เล่นคนอื่นจะมองเห็นป้ายนี้)", Color3.fromRGB(255, 150, 100))
		end

	-- B. ระบบบินไปเส้นชัยอัตโนมัติ
	elseif string.find(text, "บินไปเส้นชัย") or string.find(text, "บินไปด่านสุดท้าย") or string.find(text, "บินไปชนะ") then
		addChatMessage("AI", "กำลังเริ่มบินพุ่งตรงไปยังเส้นชัย...", Color3.fromRGB(0, 220, 255))
		flyToVictory()

	-- C. ระบบวาร์ปไปยังตำแหน่ง/สิ่งของ/พิกัด
	elseif string.find(text, "วาร์ปไป") or string.find(text, "tp to") or string.find(text, "goto") or string.find(text, "วาร์ปหา") then
		local target = string.gsub(text, "วาร์ปไป", "")
		target = string.gsub(target, "วาร์ปหา", "")
		target = string.gsub(target, "tp to", "")
		target = string.gsub(target, "goto", "")
		target = string.match(target, "^%s*(.-)%s*$")

		local ok, responseText = teleportToTarget(target)
		addChatMessage("AI", responseText, ok and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100))

	-- D. เปิดระบบ AI เล่นให้อัตโนมัติ (Auto Play)
	elseif string.find(text, "เล่นอัตโนมัติ") or string.find(text, "ให้เอไอเล่น") or string.find(text, "เอไอเล่น") or string.find(text, "auto play") then
		if string.find(text, "หยุด") or string.find(text, "ปิด") or string.find(text, "เลิก") then
			startAIAutoPlay(false)
			addChatMessage("AI", "ปิดระบบ AI เล่นให้อัตโนมัติเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))
		else
			startAIAutoPlay(true)
			addChatMessage("AI", "เปิดระบบ AI เดินเล่นออบบี้อัตโนมัติเรียบร้อยครับ!", Color3.fromRGB(100, 255, 100))
		end

