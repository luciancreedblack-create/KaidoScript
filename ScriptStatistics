-- ==================== [ AI COMMAND PROCESSOR ] ====================
processAICommand = function(msg)
	if not msg or msg == "" then return end
	local text = string.lower(msg)
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local numberInput = tonumber(string.match(text, "%d+%.?%d*"))

	if string.find(text, "afk") or string.find(text, "ไม่อยู่") then
		if string.find(text, "เลิก") or string.find(text, "กลับมา") or string.find(text, "ปิด") then
			setAFKStatus(false)
			addChatMessage("AI", "ยินดีต้อนรับกลับมา! ปิดสถานะ AFK เรียบร้อย", Color3.fromRGB(100, 255, 100))
		else
			setAFKStatus(true)
			addChatMessage("AI", "เปิดสถานะ AFK บนหัวสำเร็จ (คนอื่นมองเห็นแน่นอน)", Color3.fromRGB(255, 150, 100))
		end

	elseif string.find(text, "บินไปเส้นชัย") or string.find(text, "บินไปชนะ") then
		addChatMessage("AI", "🚀 กำลังพุ่งบินตรงไปยังเส้นชัย...", Color3.fromRGB(0, 220, 255))
		flyToVictory()

	elseif string.find(text, "วาร์ปไป") or string.find(text, "tp to") or string.find(text, "goto") or string.find(text, "วาร์ปหา") then
		local target = string.gsub(text, "วาร์ปไป", "")
		target = string.gsub(target, "วาร์ปหา", "")
		target = string.gsub(target, "tp to", "")
		target = string.gsub(target, "goto", "")
		target = string.match(target, "^%s*(.-)%s*$")

		local ok, responseText = teleportToTarget(target)
		addChatMessage("AI", responseText, ok and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100))

	elseif string.find(text, "ให้เอไอเล่น") or string.find(text, "auto play") then
		if string.find(text, "หยุด") or string.find(text, "ปิด") then
			startAIAutoPlay(false)
			addChatMessage("AI", "ปิดระบบ AI เล่นอัตโนมัติแล้ว", Color3.fromRGB(255, 200, 100))
		else
			startAIAutoPlay(true)
			addChatMessage("AI", "🤖 เปิดระบบ AI เดินเล่นออบบี้อัตโนมัติเรียบร้อย!", Color3.fromRGB(100, 255, 100))
		end

	elseif string.find(text, "เช็คแมพ") or string.find(text, "ข้อมูลแมพ") then
		checkMapUpdates()

	elseif string.find(text, "ยูทูป") or string.find(text, "youtube") or string.find(text, "yt") or string.find(text, "เพลง") then
		local videoId = string.match(msg, "https?://%S+") or string.match(msg, "watch%?v=(%S+)") or string.match(msg, "youtu%.be/(%S+)")
		openYouTubePlayer(videoId or "dQw4w9WgXcQ")
		addChatMessage("AI", "เปิดหน้าต่าง YouTube เรียบร้อย!", Color3.fromRGB(255, 90, 90))

	elseif string.find(text, "บิน") or string.find(text, "fly") then
		if string.find(text, "หยุด") or string.find(text, "ปิด") or string.find(text, "ลง") then
			setFly(false)
			addChatMessage("AI", "ปิดการบินเรียบร้อย", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 60
			setFly(true, spd)
			addChatMessage("AI", "✈️ เปิดโหมดบินความเร็ว " .. spd, Color3.fromRGB(100, 255, 100))
		end

	elseif string.find(text, "วิ่ง") or string.find(text, "speed") then
		if string.find(text, "ปกติ") then
			if hum then hum.WalkSpeed = 16 end
			addChatMessage("AI", "รีเซ็ตความเร็วเดินเป็นปกติแล้ว", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput || 100
			if hum then hum.WalkSpeed = spd end
			addChatMessage("AI", "⚡ ปรับความเร็วเป็น " .. spd, Color3.fromRGB(100, 255, 100))
		end

	elseif string.find(text, "สวัสดี") or string.find(text, "hi") or string.find(text, "hello") then
		addChatMessage("AI", "สวัสดีครับ! ผมคือสุดยอด AI Assistant ยินดีให้บริการ มีอะไรให้ช่วยสั่งการไหมครับ?", Color3.fromRGB(150, 220, 255))
	elseif string.find(text, "คำสั่ง") or string.find(text, "help") then
		addChatMessage("AI", "💡 คำสั่งทั้งหมด:\n1. 'บินไปเส้นชัย'\n2. 'วาร์ปไป [ชื่อผู้เล่น/พิกัด]'\n3. 'afk'\n4. 'ให้เอไอเล่น'\n5. 'บิน [ความเร็ว]'\n6. 'ยูทูป [ลิงก์]'", Color3.fromRGB(255, 220, 120))
	else
		addChatMessage("AI", "รับทราบคำสั่งครับ! พิมพ์ 'help' เพื่อดูรายการคำสั่งทั้งหมดได้เลย", Color3.fromRGB(180, 220, 255))
	end
end

