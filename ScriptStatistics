	-- ฟังก์ชันเพิ่มข้อความแชต
	addChatMessage = function(sender, text, color)
		color = color or Color3.fromRGB(255, 255, 255)
		local msgLabel = Instance.new("TextLabel")
		msgLabel.Size = UDim2.new(1, -10, 0, 0)
		msgLabel.AutomaticSize = Enum.AutomaticSize.Y
		msgLabel.BackgroundTransparency = 1
		msgLabel.Text = "<b>" .. sender .. ":</b> " .. text
		msgLabel.TextColor3 = color
		msgLabel.Font = Enum.Font.SourceSans
		msgLabel.TextSize = 14
		msgLabel.TextWrapped = true
		msgLabel.RichText = true
		msgLabel.TextXAlignment = Enum.TextXAlignment.Left
		msgLabel.Parent = scrollFrame

		task.wait(0.03)
		scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.AbsoluteCanvasSize.Y)
	end

	local function handleSend()
		local msg = inputBox.Text
		if msg and msg ~= "" then
			addChatMessage("คุณ", msg, Color3.fromRGB(200, 255, 200))
			inputBox.Text = ""
			processAICommand(msg)
		end
	end

	sendBtn.MouseButton1Click:Con
