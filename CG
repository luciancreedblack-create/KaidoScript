-- [[ Ultimate Roblox Style Name Tag & Draggable GUI ]] --
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LP = Players.LocalPlayer

-- ฟังก์ชันสร้างป้ายชื่อบนหัว (ฟอนต์ Roblox ดั้งเดิม ตัวเล็ก คมชัด)
local function createRobloxTag(character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	-- ลบป้ายเก่าทิ้งก่อนกันซ้ำ
	if head:FindFirstChild("RobloxStyleTag") then
		head.RobloxStyleTag:Destroy()
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "RobloxStyleTag"
	billboard.Size = UDim2.new(0, 200, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = head

	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "NameText"
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = LP.Name -- ใช้ชื่อเริ่มต้นเป็นชื่อของคุณ
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 18
	textLabel.Font = Enum.Font.SourceSansBold
	textLabel.Parent = billboard

	-- ขอบดำบางๆ เพื่อความคมชัดแบบป้ายชื่อแท้ของ Roblox
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Parent = textLabel

	billboard.Parent = head
end

-- สร้าง UI เมนูพิมพ์เปลี่ยนชื่อ
local function createUI()
	local playerGui = LP:WaitForChild("PlayerGui")
	if playerGui:FindFirstChild("RobloxNameChangerUI") then
		playerGui.RobloxNameChangerUI:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "RobloxNameChangerUI"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 260, 0, 90)
	frame.Position = UDim2.new(0.5, -130, 0.8, 0)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	frame.BackgroundTransparency = 0.15
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(200, 200, 200)
	stroke.Thickness = 1.5
	stroke.Parent = frame

	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.9, 0, 0.4, 0)
	textBox.Position = UDim2.new(0.05, 0, 0.1, 0)
	textBox.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	textBox.PlaceholderText = "พิมพ์ชื่อใหม่ที่นี่..."
	textBox.Text = ""
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.TextSize = 16
	textBox.Font = Enum.Font.SourceSansBold
	textBox.Parent = frame
	Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 6)

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0.9, 0, 0.35, 0)
	button.Position = UDim2.new(0.05, 0, 0.55, 0)
	button.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	button.Text = "เปลี่ยนชื่อ"
	button.TextColor3 = Color3.fromRGB(0, 0, 0)
	button.TextSize = 16
	button.Font = Enum.Font.SourceSansBold
	button.Parent = frame
	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

	-- ปุ่มกดเปลี่ยนชื่อ
	button.MouseButton1Click:Connect(function()
		local newName = textBox.Text
		if newName ~= "" and LP.Character and LP.Character:FindFirstChild("Head") then
			local tag = LP.Character.Head:FindFirstChild("RobloxStyleTag")
			if tag and tag:FindFirstChild("NameText") then
				tag.NameText.Text = newName
			end
		end
	end)

	-- ระบบลาก UI ย้ายตำแหน่ง
	local dragging, dragStart, startPos
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- รันระบบสร้างป้ายชื่อและ UI เมนู
LP.CharacterAdded:Connect(createRobloxTag)
if LP.Character then
	task.spawn(createRobloxTag, LP.Character)
end

createUI()
