-- ฟังก์ชันสร้างปุ่มฟังก์ชัน
local function createButton(name, posY, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 38)
	btn.Position = UDim2.new(0.05, 0, 0, posY)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.FredokaOne
	btn.TextSize = 14
	btn.Parent = mainFrame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	
	local active = false
	btn.MouseButton1Click:Connect(function()
		active = not active
		if active then
			btn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
			btn.Text = name .. " [ON]"
		else
			btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
			btn.Text = name .. " [OFF]"
		end
		callback(active)
	end)
end

-- สร้างปุ่มฟีเจอร์โกงเหรียญและช่วยเล่น
createButton("💰 Auto Farm & Treat Patients (ฟาร์มเงิน/รักษาอัตโนมัติ)", 55, function(state)
	task.spawn(function()
		while state do
			task.wait(0.5)
			pcall(function()
				-- จำลองการปฏิสัมพันธ์กับผู้ป่วยและเคสในโรงพยาบาลเพื่อรับเงิน
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("ProximityPrompt") and (string.find(string.lower(obj.ActionText), "treat") or string.find(string.lower(obj.ActionText), "heal") or string.find(string.lower(obj.ActionText), "cure")) then
						fireproximityprompt(obj)
					end
				end
			end)
		end
	end)
end)

createButton("🧠 Infinite Sanity (สติเต็มตลอดกาล ไม่หลอน)", 100, function(state)
	task.spawn(function()
		while state do
			task.wait(1)
			pcall(function()
				-- ล้างค่าความกลัวหรือสติแตกในตัวละคร (ถ้ามี Value ควบคุม Sanity)
				local stats = LP:FindFirstChild("leaderstats") or LP:FindFirstChild("PlayerStats")
				if stats then
					for _, stat in ipairs(stats:GetChildren()) do
						if string.find(string.lower(stat.Name), "sanity") or string.find(string.lower(stat.Name), "fear") then
							stat.Value = 100 -- หรือปรับตามค่าสูงสุดของเกม
						end
					end
				end
			end)
		end
	end)
end

