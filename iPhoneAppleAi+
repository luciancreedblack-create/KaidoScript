-- [[ 📱 iPhone AI+ Ultimate: All-in-One Integrated Script ]] --
-- ⚠️ นำสคริปต์นี้ไปวางไว้ใน ServerScriptService (อันเดียวจบครบทุกระบบ) --

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

-- 1. สร้าง RemoteEvent สำหรับระบบซื้อของกลางระบบ
local remotes = ReplicatedStorage:FindFirstChild("AI_Remotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "AI_Remotes"
	remotes.Parent = ReplicatedStorage
end

local promptEvent = remotes:FindFirstChild("PromptPurchaseEvent")
if not promptEvent then
	promptEvent = Instance.new("RemoteEvent")
	promptEvent.Name = "PromptPurchaseEvent"
	promptEvent.Parent = remotes
end

-- ⚠️ สำคัญ: ใส่ Product ID ของ Developer Product (ราคา 1 Robux) ของคุณ RTKT995 ที่นี่
local PRODUCT_ID = 0 

promptEvent.OnServerEvent:Connect(function(player)
	if player.Name == "RTKT995" or player.DisplayName == "RTKT995" then
		return -- VIP ไม่ต้องจ่าย
	end
	
	if PRODUCT_ID > 0 then
		pcall(function()
			MarketplaceService:PromptProductPurchase(player, PRODUCT_ID)
		end)
	else
		warn("ยังไม่ได้ตั้งค่า Product ID สำหรับ 1 Robux!")
	end
end)

MarketplaceService.ProcessReceipt = function(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if player and receiptInfo.ProductId == PRODUCT_ID then
		local paidVal = player:FindFirstChild("AI_PaidStatus")
		if not paidVal then
			paidVal = Instance.new("BoolValue")
			paidVal.Name = "AI_PaidStatus"
			paidVal.Value = true
			paidVal.Parent = player
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

