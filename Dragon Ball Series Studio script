-- ฟังก์ชันสร้างปุ่มสกิลด้านในหน้าต่าง
local function createSkillButton(name, posY, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 42)
	btn.Position = UDim2.new(0.05, 0, 0, posY)
	btn.Text = name
	btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextScaled = true
	btn.Font = Enum.Font.SourceSansBold
	btn.Parent = mainFrame
	
	btn.MouseButton1Click:Connect(callback)
end

-- ฟังก์ชันสร้างแสงออร่ารอบตัว (Visual Effect)
local function createAura(color, name)
	if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
	local hrp = Character.HumanoidRootPart
	
	if hrp:FindFirstChild("DBZAura") then
		hrp.DBZAura:Destroy()
	end
	
	local attachment = Instance.new("Attachment")
	attachment.Name = "DBZAura"
	attachment.Parent = hrp
	
	local particle = Instance.new("ParticleEmitter")
	particle.Name = name
	particle.Color = ColorSequence.new(color)
	particle.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 6)})
	particle.Texture = "rbxassetid://258129463"
	particle.Lifetime = NumberRange.new(0.5, 1)
	particle.Rate = 120
	particle.Speed = NumberRange.new(6, 18)
	particle.Parent = attachment
	
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 18
	light.Brightness = 6
	light.Parent = hrp
	
	task.delay(4, function()
		if attachment then attachment:Destroy() end
		if light then light:Destroy() end
	end)
end

