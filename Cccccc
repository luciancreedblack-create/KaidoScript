-- ==================== [ AUTO SPEECH TO TEXT SETUP ] ====================

local function setupSpeechToTextEngine()
	task.spawn(function()
		local char = LP.Character or LP.CharacterAdded:Wait()
		
		local audioDeviceInput = Instance.new("AudioDeviceInput")
		audioDeviceInput.Name = "AutoVoiceInput"
		audioDeviceInput.Player = LP
		audioDeviceInput.Parent = char

		local audioSpeechToText = Instance.new("AudioSpeechToText")
		audioSpeechToText.Name = "AutoSpeechToText"
		audioSpeechToText.Enabled = true
		audioSpeechToText.Parent = char

		local wire = Instance.new("Wire")
		wire.Name = "VoiceWire"
		wire.SourceInstance = audioDeviceInput
		wire.SourceName = "Output"
		wire.TargetInstance = audioSpeechToText
		wire.TargetName = "Input"
		wire.Parent = char

		audioSpeechToText:GetPropertyChangedSignal("Text"):Connect(function()
			local textResult = audioSpeechToText.Text
			if textResult and textResult ~= "" then
				addChatMessage("คุณ (พูด)", textResult, Color3.fromRGB(150, 255, 150))
				processAICommand(textResult)
			end
		end)
	end)
end

-- ==================== [ HIGH-IQ SMART AI PROCESSOR ] ====================

processAICommand = function(msg)
	local text = string.lower(msg)
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	local numberInput = tonumber(string.match(text, "%d+%.?%d*"))

	-- A. เปิดระบบ AI เล่นให้อัตโนมัติ (Auto Play)
	if string.find(text, "เล่นอัตโนมัติ") or string.find(text, "ให้เอไอเล่น") or string.find(text, "เอไอเล่น") or string.find(text, "auto play") then
		if string.find(text, "หยุด") or string.find(text, "ปิด") or string.find(text, "เลิก") then
			startAIAutoPlay(false)
			addChatMessage("AI", "ปิดระบบ AI เล่นให้อัตโนมัติเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))
		else
			startAIAutoPlay(true)
			addChatMessage("AI", "เปิดระบบ AI เล่นให้อัตโนมัติ + ป้องกัน AFK เรียบร้อยครับ!", Color3.fromRGB(100, 255, 100))
		end

	-- B. เช็คแมพอัปเดต
	elseif string.find(text, "อัปเดต") or string.find(text, "เช็คแมพ") then
		checkMapUpdates()

	-- C. วาร์ปไปออบบี้ / จุดชัยชนะ
	elseif string.find(text, "ออบบี้") or string.find(text, "obby") or string.find(text, "ชัยชนะ") or string.find(text, "ด่าน") then
		teleportToVictory()
		addChatMessage("AI", "วาร์ปไปที่ชัยชนะเรียบร้อยครับ!", Color3.fromRGB(0, 255, 150))

	-- D. เปิดดู YouTube
	elseif string.find(text, "ยูทูป") or string.find(text, "youtube") or string.find(text, "yt") or string.find(text, "คลิป") or string.find(text, "เพลง") then
		local videoId = string.match(msg, "https?://%S+") or string.match(msg, "watch%?v=(%S+)") or string.match(msg, "youtu%.be/(%S+)") or string.match(msg, "%w%w%w%w%w%w%w%w%w%w%w")
		openYouTubePlayer(videoId or "dQw4w9WgXcQ")
		addChatMessage("AI", "เปิดหน้าต่างเล่น YouTube เรียบร้อยครับ!", Color3.fromRGB(255, 80, 80))

	-- E. เปลี่ยนภาษา
	elseif string.find(text, "ภาษา") or string.find(text, "แปล") or string.find(text, "lang") then
		local selectedLang = "en"
		local langName = "ภาษาอังกฤษ"
		for key, code in pairs(languageCodes) do
			if string.find(text, key) then
				selectedLang = code
				langName = key
				break
			end
		end
		translateMapToLanguage(selectedLang)
		addChatMessage("AI", "เปลี่ยนภาษาแมพเป็น " .. langName .. " เรียบร้อยครับ!", Color3.fromRGB(0, 200, 255))

	-- F. บิน
	elseif string.find(text, "บิน") or string.find(text, "ลอย") or string.find(text, "fly") then
		if string.find(text, "หยุด") or string.find(text, "ปิด") or string.find(text, "ลง") then
			setFly(false)
			addChatMessage("AI", "ปิดระบบการบินเรียบร้อยครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 60
			setFly(true, spd)
			addChatMessage("AI", "เปิดโหมดบินความเร็ว " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- G. ปรับความเร็ว
	elseif string.find(text, "วิ่ง") or string.find(text, "เดิน") or string.find(text, "speed") then
		if string.find(text, "ปกติ") then
			if hum then hum.WalkSpeed = 16 end
			addChatMessage("AI", "ปรับความเร็วเดินปกติแล้วครับ", Color3.fromRGB(255, 200, 100))
		else
			local spd = numberInput or 100
			if hum then hum.WalkSpeed = spd end
			addChatMessage("AI", "ปรับความเร็วการวิ่งเป็น " .. spd .. " เรียบร้อยครับ", Color3.fromRGB(100, 255, 100))
		end

	-- H. คำทักทาย / คุยเล่น
	elseif string.find(text, "หวัดดี") or string.find(text, "สวัสดี") or string.find(text, "hi") or string.find(text, "hello") then
		addChatMessage("AI", "สวัสดีครับ! สั่งงานได้ทั้งการพิมพ์และพูดผ่านไมค์เลยครับ", Color3.fromRGB(150, 220, 255))
	else
		addChatMessage("AI", "รับทราบครับ! สามารถสั่ง 'ให้เอไอเล่น', 'บิน', หรือ 'เช็คแมพ' ได้เลยครับ", Color3.fromRGB(180, 220, 255))
	end
end

