	textBox.Size = UDim2.new(0.72, 0, 1, 0)
	textBox.Position = UDim2.new(0.03, 0, 0, 0)
	textBox.BackgroundTransparency = 1
	textBox.PlaceholderText = "พิมพ์สั่ง AI เช่น 'ให้เอไอเล่น', 'บิน'..."
	textBox.Text = ""
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.Font = Enum.Font.SourceSans
	textBox.TextSize = 14
	textBox.TextXAlignment = Enum.TextXAlignment.Left
	textBox.Parent = inputFrame

	local sendBtn = Instance.new("TextButton")
	sendBtn.Size = UDim2.new(0.2, 0, 0.8, 0)
	sendBtn.Position = UDim2.new(0.77, 0, 0.1, 0)
	sendBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	sendBtn.Text = "ส่ง"
	sendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	sendBtn.Font = Enum.Font.FredokaOne
	sendBtn.TextSize = 13
	sendBtn.Parent = inputFrame
	Instance.new("UICorner", sendBtn).CornerRadius = UDim.new(0, 4)

	addChatMessage = function(sender, text, color)
		local msgLabel = Instance.new("TextLabel")
		msgLabel.Size = UDim2.new(1, 0, 0, 0)
		msgLabel.BackgroundTransparency = 1
		msgLabel.Text = "<b>" .. sender .. ":</b> " .. text
		msgLabel.RichText = true
		msgLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
		msgLabel.Font = Enum.Font.SourceSans
		msgLabel.TextSize = 14
		msgLabel.TextWrapped = true
		msgLabel.TextXAlignment = Enum.TextXAlignment.Left
		msgLabel.Parent = scrollFrame

		msgLabel.Size = UDim2.new(1, 0, 0, msgLabel.TextBounds.Y + 2)
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y + 10)
		scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
	end

	local function onSend()
		local text = textBox.Text
		if text ~= "" then
			textBox.Text = ""
			addChatMessage("คุณ", text, Color3.fromRGB(200, 220, 255))
			processAICommand(text)
		end
	end

	sendBtn.MouseButton1Click:Connect(onSend)
	textBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then onSend() end
	end)

	-- Dragging System (ลากย้ายหน้าต่างได้)
	local dragging, dragInput, dragStart, startPos
	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	titleBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	addChatMessage("AI", "ระบบพร้อมใช้งาน! พิมพ์สั่ง 'ให้เอไอเล่น' เพื่อให้ AI เดินเล่นออบบี้อัตโนมัติได้เลยครับ", Color3.fromRGB(150, 220, 255))
	checkMapUpdates()
end

