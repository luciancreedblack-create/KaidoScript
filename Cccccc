-- 1. ระบบ ANTI-AFK (ป้องกันการถูกเตะเมื่อพับจอ/ไม่ขยับตัว)
local function enableAntiAFK()
	LP.Idled:Connect(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new(0, 0))
	end)
	
	task.spawn(function()
		while true do
			task.wait(30)
			pcall(function()
				VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
				task.wait(0.1)
				VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
			end)
		end
	end)
end

-- 2. ระบบ AI เล่นอัตโนมัติ (Auto-Play AI System)
local function startAIAutoPlay(state)
	autoPlayActive = state
	if not autoPlayActive then return end

	task.spawn(function()
		while autoPlayActive do
			task.wait(0.5)
			local char = LP.Character
			if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
				local hrp = char.HumanoidRootPart
				local hum = char:FindFirstChildOfClass("Humanoid")

				-- ค้นหา Checkpoint หรือจุดหมายถัดไปในแมพ
				local targetPart = nil
				local minDistance = math.huge

				for _, part in ipairs(workspace:GetDescendants()) do
					if part:IsA("BasePart") then
						local name = string.lower(part.Name)
						if string.find(name, "stage") or string.find(name, "checkpoint") or string.find(name, "spawn") or string.find(name, "win") then
							local dist = (part.Position - hrp.Position).Magnitude
							if dist > 5 and dist < minDistance then
								minDistance = dist
								targetPart = part
							end
						end
					end
				end

				-- เดินไปหาจุดหมาย หรือขยับตัวอัตโนมัติ
				if targetPart then
					hum:MoveTo(targetPart.Position)
				else
					hum:MoveTo(hrp.Position + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)))
				end
			end
		end
	end)
end

-- 3. ระบบบิน
local function setFly(state, speed)
	if speed then flySpeed = speed end
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	local hum = char:FindFirstChildOfClass("Humanoid")

	if state then
		if isFlying then return end
		isFlying = true
		if hum then hum.PlatformStand = true end

		bodyVelocity = Instance.new("BodyVelocity", hrp)
		bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
		bodyVelocity.Velocity = Vector3.zero

		bodyGyro = Instance.new("BodyGyro", hrp)
		bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 100000
		bodyGyro.CFrame = hrp.CFrame

		task.spawn(function()
			while isFlying and char and hrp do
				local camera = workspace.CurrentCamera
				local moveDir = hum and hum.MoveDirection or Vector3.zero
				if moveDir.Magnitude > 0 then
					bodyVelocity.Velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z)) * flySpeed
				else
					bodyVelocity.Velocity = Vector3.zero
				end
				bodyGyro.CFrame = camera.CFrame
				RunService.RenderStepped:Wait()
			end
		end)
	else
		isFlying = false
		if hum then hum.PlatformStand = false end
		if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	end
end

