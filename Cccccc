-- 5. ระบบเปลี่ยนภาษาทั้งแมพ
local function translateMapToLanguage(langCode)
	local playerGui = LP:WaitForChild("PlayerGui")
	local count = 0
	for _, desc in ipairs(game:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
			if desc.Text ~= "" and not desc:IsDescendantOf(playerGui:FindFirstChild("PrivateAIChatGui")) then
				count = count + 1
				task.spawn(function()
					pcall(function()
						local translated = LocalizationService:GetTranslatorForLocaleAsync(langCode):Translate(game, desc.Text)
						if translated and translated ~= "" then
							desc.Text = translated
						end
					end)
				end)
			end
		end
	end
	return count
end

-- 6. ระบบวาร์ปไปจุดชัยชนะ Obby
local function teleportToVictory()
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
	local hrp = char.HumanoidRootPart

	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("BasePart") or item:IsA("Model") then
			local name = string.lower(item.Name)
			if string.find(name, "win") or string.find(name, "victory") or string.find(name, "finish") or string.find(name, "end") or string.find(name, "ชัยชนะ") then
				local targetCFrame = item:IsA("Model") and item:GetPivot() or item.CFrame
				hrp.CFrame = targetCFrame + Vector3.new(0, 4, 0)
				return true
			end
		end
	end
	
	hrp.CFrame = hrp.CFrame + Vector3.new(0, 300, 0)
	return true
end

